{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_sha256": {"pattern": "[0-9a-f]{64}", "type": "string"},
    "binary_output_binding": {"const": true, "type": "boolean"},
    "corpus_sha256": {"pattern": "[0-9a-f]{64}", "type": "string"},
    "gpu_uuid": {"minLength": 1, "type": "string"},
    "module_sha256": {
      "items": {"pattern": "[0-9a-f]{64}", "type": "string"},
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "operations": {
      "items": {"enum": ["KeyGen", "Encaps", "Decaps", "Sign", "Verify"], "type": "string"},
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "participant_role": {"minLength": 1, "type": "string"},
    "release_family_id": {"pattern": "LOCE-PQC-GPU-H006-[0-9]{8}T[0-9]{6}Z", "type": "string"},
    "schema": {"const": "loce.hardening006.performance-correctness.v1", "type": "string"},
    "status": {"enum": ["PASS", "FAIL"], "type": "string"},
    "timed_output_binding": {"const": true, "type": "boolean"},
    "validator_revision": {"pattern": "[0-9a-f]{40}", "type": "string"}
  },
  "required": ["schema", "release_family_id", "participant_role", "status", "benchmark_sha256", "module_sha256", "corpus_sha256", "gpu_uuid", "operations", "binary_output_binding", "timed_output_binding", "validator_revision"],
  "type": "object"
}
