{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loce-lab.example/schemas/canonical-correctness-manifest-v1.json",
  "title": "LoCE canonical correctness manifest",
  "type": "object",
  "required": [
    "schema", "status", "algorithm", "security_level", "parameter_set",
    "operation", "source_tree_sha256", "framework_source_sha256", "binary",
    "binary_sha256", "contract_hash", "policy_hash", "corpus_sha256",
    "correctness_corpus", "correctness_corpus_sha256", "reference_id",
    "differential_evidence", "differential_evidence_sha256",
    "sanitizer_summary", "sanitizer_summary_sha256", "gates",
    "performance_eligible", "performance_evidence",
    "performance_evidence_sha256", "adapter_evidence",
    "adapter_evidence_sha256", "invalid_historical_families"
  ],
  "properties": {
    "schema": {"const": "loce-canonical-correctness-manifest-v1"},
    "status": {"const": "pass"},
    "algorithm": {"enum": ["ML-KEM", "ML-DSA"]},
    "security_level": {"enum": [1, 3, 5]},
    "parameter_set": {"type": "string"},
    "operation": {"enum": ["KeyGen", "Encaps", "Decaps", "Sign", "Verify"]},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "framework_source_sha256": {"$ref": "#/$defs/sha256"},
    "binary_sha256": {"$ref": "#/$defs/sha256"},
    "contract_hash": {"$ref": "#/$defs/sha256"},
    "policy_hash": {"$ref": "#/$defs/sha256"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "correctness_corpus_sha256": {"$ref": "#/$defs/sha256"},
    "differential_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "sanitizer_summary_sha256": {"$ref": "#/$defs/sha256"},
    "performance_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "binary": {"$ref": "#/$defs/relative_path"},
    "differential_evidence": {"$ref": "#/$defs/relative_path"},
    "sanitizer_summary": {"$ref": "#/$defs/relative_path"},
    "performance_evidence": {"$ref": "#/$defs/relative_path"},
    "adapter_evidence": {"$ref": "#/$defs/relative_path"},
    "reference_id": {"type": "array", "minItems": 2},
    "gates": {
      "type": "object",
      "required": [
        "terminal", "byte_exact", "cpu_verify_or_decaps", "attempt_kappa",
        "winner_record", "decaps_fail_path", "second_reference", "sanitizer"
      ],
      "additionalProperties": false,
      "properties": {
        "terminal": {"$ref": "#/$defs/gate"},
        "byte_exact": {"$ref": "#/$defs/gate"},
        "cpu_verify_or_decaps": {"$ref": "#/$defs/gate"},
        "attempt_kappa": {"$ref": "#/$defs/gate"},
        "winner_record": {"$ref": "#/$defs/gate"},
        "decaps_fail_path": {"$ref": "#/$defs/gate"},
        "second_reference": {"$ref": "#/$defs/gate"},
        "sanitizer": {"$ref": "#/$defs/gate"}
      }
    },
    "performance_eligible": {"type": "boolean"},
    "invalid_historical_families": {"type": "array", "minItems": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "minLength": 1},
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["applicable", "status", "evidence"],
          "additionalProperties": false,
          "properties": {
            "applicable": {"const": true},
            "status": {"const": "PASS"},
            "evidence": {"$ref": "#/$defs/relative_path"}
          }
        },
        {
          "type": "object",
          "required": ["applicable", "status", "evidence"],
          "additionalProperties": false,
          "properties": {
            "applicable": {"const": false},
            "status": {"const": "N/A"},
            "evidence": {"type": "null"}
          }
        }
      ]
    }
  }
}
