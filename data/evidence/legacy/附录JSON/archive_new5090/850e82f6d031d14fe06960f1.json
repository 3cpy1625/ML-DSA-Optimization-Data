{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loce.hardening006.release-identity.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_family_id", "gates", "active_evidence"],
  "properties": {
    "schema": {"const": "loce.hardening006.release-identity.v1"},
    "release_family_id": {
      "type": "string",
      "pattern": "^LOCE-PQC-GPU-H006-[A-Za-z0-9-]+$"
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "build_id": {"type": "string", "minLength": 1},
    "gates": {"type": "object"},
    "active_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "artifact-reference.schema.json"}
    }
  }
}
