{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoCE-PQC-GPU correctness manifest",
  "type": "object",
  "required": [
    "status",
    "source_hash",
    "framework_source_hash",
    "binary_hash",
    "validator_revision",
    "positive_oracle",
    "negative_controls",
    "timed_output_binding",
    "terminal_completion",
    "sanitizer_pass",
    "performance_eligible"
  ],
  "properties": {
    "status": {"enum": ["pass", "fail", "unverified"]},
    "source_hash": {"type": "string", "minLength": 64},
    "framework_source_hash": {"type": "string", "minLength": 64},
    "binary_hash": {"type": "string", "minLength": 64},
    "validator_revision": {"type": "string", "minLength": 1},
    "positive_oracle": {"type": "string", "minLength": 1},
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "timed_output_binding": {"type": "boolean"},
    "terminal_completion": {"type": "boolean"},
    "sanitizer_pass": {"type": "boolean"},
    "performance_eligible": {"type": "boolean"}
  },
  "additionalProperties": true
}
